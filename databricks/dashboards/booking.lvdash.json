{
  "datasets": [
    {
      "name": "daily",
      "displayName": "Hotel KPIs by night",
      "queryLines": [
        "SELECT date, sum(sold_room_nights) / sum(available_room_nights) AS occupancy, sum(room_revenue_usd) / nullif(sum(sold_room_nights), 0) AS adr_usd, sum(room_revenue_usd) / sum(available_room_nights) AS revpar_usd FROM booking.gold.kpi_hotel_daily GROUP BY date"
      ]
    },
    {
      "name": "pace",
      "displayName": "Booking pace",
      "queryLines": [
        "SELECT days_before, sum(cumulative_bookings) AS cumulative_bookings FROM booking.gold.booking_pace GROUP BY days_before"
      ]
    },
    {
      "name": "lead",
      "displayName": "Lead time",
      "queryLines": [
        "SELECT lead_time_days, sum(bookings) AS bookings FROM booking.gold.lead_time GROUP BY lead_time_days"
      ]
    },
    {
      "name": "cancel",
      "displayName": "Cancellations",
      "queryLines": [
        "SELECT check_in_month, sum(cancelled) / sum(paid) AS cancellation_rate FROM booking.gold.cancellation_rate GROUP BY check_in_month"
      ]
    },
    {
      "name": "regions",
      "displayName": "Contention by region",
      "queryLines": [
        "SELECT home_region, attempts - rejected AS won, rejected, conflict_rate FROM booking.gold.conflict_rate_by_region"
      ]
    },
    {
      "name": "quality",
      "displayName": "Expectations",
      "queryLines": [
        "SELECT concat(dataset, ' / ', expectation) AS expectation, sum(passed_records) AS passed, sum(failed_records) AS failed FROM booking.gold.data_quality GROUP BY ALL"
      ]
    },
    {
      "name": "quarantine",
      "displayName": "Quarantine",
      "queryLines": [
        "SELECT rule, count(*) AS quarantined_rows FROM booking.silver.quarantine_events GROUP BY rule"
      ]
    }
  ],
